# LLM provider. Open-weights models only (hard rule 2).
#   ollama  local, free, no quota: the default for development, evals and repeat runs
#   groq    hosted: for the demo, the demo video and the final sample run (free tier: about 200,000 tokens/day for Qwen)
LLM_PROVIDER=ollama

# Ollama default: qwen2.5:7b  (run `ollama pull qwen2.5:7b` once)
# Groq default:   qwen/qwen3.8-27b, chosen by measurement; see README "Agent architecture".
#                 Run `python -m agent.models` to list what YOUR key can use: a model in Groq's docs may be unavailable.
MODEL=qwen2.5:7b

# Groq key (never commit the real .env). Not needed for LLM_PROVIDER=ollama.
GROQ_API_KEY=

# Optional: Ollama server address
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: point the zabuni-mcp server at other data / rules / a flags store.
# These ZABUNI_* variables (and only these) are forwarded to the server subprocess.
# ZABUNI_DB=data/zabuni.duckdb
# ZABUNI_RULES_FILE=my_rules.json
# ZABUNI_FLAGS_DB=data/flags.duckdb
