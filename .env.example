# LLM provider: groq (hosted demo) or ollama (local). Open-weights models only (hard rule 2).
LLM_PROVIDER=groq

# Groq default: qwen/qwen3.8-27b (Alibaba's open-weights Qwen), chosen by measurement; see README "Agent architecture".
# Run `python -m agent.models` to list what YOUR key can use: a model in Groq's docs may be unavailable to an account.
# Ollama fallback: qwen2.5:7b (or llama3.1:8b), e.g. LLM_PROVIDER=ollama and MODEL=qwen2.5:7b
MODEL=qwen/qwen3.8-27b

# Groq key (never commit the real .env). Not needed for LLM_PROVIDER=ollama.
GROQ_API_KEY=

# Optional: Ollama server address
# OLLAMA_BASE_URL=http://localhost:11434

# Optional: point the zabuni-mcp server at other data / rules / a flags store.
# These ZABUNI_* variables (and only these) are forwarded to the server subprocess.
# ZABUNI_DB=data/zabuni.duckdb
# ZABUNI_RULES_FILE=my_rules.json
# ZABUNI_FLAGS_DB=data/flags.duckdb
