# Copy these lines into the app's Secrets box on share.streamlit.io (Advanced settings -> Secrets),
# or save as .streamlit/secrets.toml for a local run. NEVER commit a file with real values.
GROQ_API_KEY = "gsk_replace_with_your_groq_key"
HF_TOKEN = "hf_replace_with_a_read_only_token_for_the_private_dataset"
LLM_PROVIDER = "groq"
MODEL = "qwen/qwen3.8-27b"
